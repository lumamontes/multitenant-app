{
  "name": "multitenant",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "config:generate": "tsx scripts/generateConfigs.ts",
    "build:all": "tsx scripts/buildAll.ts",
    "build:validate": "tsx scripts/validateTenants.ts",
    "tenant:add": "tsx scripts/addTenant.ts && npm run config:generate",
    "tenant:list": "tsx scripts/listTenants.ts",
    "tenant:info": "tsx scripts/getTenantInfo.ts",
    "tenant:validate": "tsx scripts/validateTenants.ts",
    "dev:tenant1": "TENANT=tenant1 expo start",
    "dev:tenant2": "TENANT=tenant2 expo start",
    "build:all:parallel": "tsx scripts/buildAllParallel.ts",
    "build:all:dry": "tsx scripts/buildAll.ts all production --dry-run",
    "build:ios": "tsx scripts/buildAll.ts ios production",
    "build:android": "tsx scripts/buildAll.ts android production",
    "build:preview": "tsx scripts/buildAll.ts all preview",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "workflows:generate": "npm run config:generate",
    "workflows:validate": "gh workflow list",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.9",
    "expo-blur": "~14.1.4",
    "expo-constants": "~17.1.6",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.1.7",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.6",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "inquirer": "^12.6.3",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  },
  "private": true
}
